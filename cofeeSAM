.text-bright {
    color: #f0e6c8
}

a.text-bright:focus,
a.text-bright:hover {
    color: #f5ecd6
}

.text-blue {
    color: var(--text-color)
}

.text-purple {
    color: #a67462
}

a {
    color: var(--color-blue)
}

a:hover {
    color: var(--color-light-blue)
}

.text-green {
    color: var(--color-light-green)
}

.text-muted {
    color: #ab9f7c
}

.text-red {
    color: var(--color-light-red)
}

.text-orange {
    color: var(--color-light-orange)
}

.text-pink {
    color: #a67462
}

.text-danger {
    color: var(--color-light-red)
}

.badge-user {
    box-shadow: none;
    text-shadow: 1.5px 1.5px #000;
    background-color: #2f3327;
    border: 0
}

.footer__icon {
    color: #a67462
}

#frame {
    background: #1e211a
}

#frame .content .messages ul li {
    border-bottom: 1px dashed #3a3d30
}

.chatbox .typing {
    color: #ded0a0
}

#frame .content .messages ul li.sent h4 .text-muted {
    color: #8f8567
}

#frame .content .messages ul li>img {
    border: 3px solid #c9a554
}

#frame .content .message-input .wrap input {
    color: #2a2620
}

#frame .content .message-input .wrap input:focus {
    outline: none
}

#frame .content .message-input .wrap .attachment {
    color: #4f6b52
}

#frame .content .message-input .wrap button {
    color: #f0e6c8;
    background: #3d5240
}

#frame .content .message-input .wrap button:hover {
    background: #4f6b52
}

.sent>a {
    height: 100%;
    position: absolute;
    bottom: 0
}

.sent>a>img {
    height: 100%;
    position: absolute;
    bottom: 4px;
    display: block!important
}

#frame .content .messages ul li.sent img.chat-user-image {
    width: 40px;
    height: 40px
}

.sent>h4 {
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    margin: 4px 12px 0 48px;
    padding: 4px 12px 0 8px;
    background-color: var(--message-bubble-bg)!important;
    display: block!important
}

.sent>div {
    border-bottom-right-radius: 15px;
    background-color: var(--message-bubble-bg)!important;
    margin: 0 12px 4px 48px!important;
    padding: 0 12px 4px 8px!important;
    display: block!important
}

.sent>.system {
    border-bottom-left-radius: 15px
}

.sent>div:not(.system):before {
    content: "";
    border-top: 10px solid #0000;
    width: 0;
    position: absolute;
    bottom: 4px;
    left: 38px;
    border-right: 10px solid var(--message-bubble-bg)!important
}

#frame .content .messages ul li.sent {
    border: 0;
    width: auto;
    max-width: 85%;
    display: table
}

#frame .content .messages ul li.sent h4 .text-muted {
    float: none
}

body {
    max-width: 1440px;
    margin: 0 auto
}

main {
    background-color: var(--body-bg-secondary);
    margin: 0 2rem;
    padding: 2rem
}

main:has(>article>section.meta) {
    background: #0f0f0f33
}

.page__torrents,
.user-torrents,
.user-peers {
    margin: 0!important
}

.user-torrents,
.user-peers {
    width: unset;
    align-self: unset
}

.user-torrents .data-table>tbody>tr>td,
.user-peers .data-table>tbody>tr>td,
.user-torrents__name {
    font-size: 10px
}

.top-nav {
    background-color: var(--top-nav-bg);
    grid-template: "left""right"/1fr;
    align-items: center;
    padding: 1rem 2rem .5rem;
    display: grid
}

.top-nav__left {
    grid-area: left;
    justify-content: space-between;
    column-gap: 32px;
    width: 100%;
    margin-bottom: .5rem;
    display: flex
}

.top-nav__main-menus {
    grid-area: right;
    justify-self: start;
    align-items: center;
    margin: auto 0;
    padding: 0;
    list-style-type: none;
    display: flex
}

.top-nav__right {
    grid-area: right;
    column-gap: 40px;
    width: 60%;
    margin-left: auto;
    display: flex;
    position: relative;
    top: -6rem;
    container-type: inline-size
}

.top-nav__ratio-bar.top-nav__ratio-bar {
    grid-template-rows: repeat(2, auto);
    grid-template-columns: repeat(4, auto);
    font-size: 12px;
    display: grid
}

.top-nav__stats {
    display: none
}

@container (width>=800px) {
    .top-nav__ratio-bar.top-nav__ratio-bar {
        grid-template-rows: auto;
        grid-template-columns: repeat(8, auto);
        font-size: 12px;
        display: grid
    }
    .top-nav__ratio-bar li:nth-child(-n+4),
    .top-nav__ratio-bar li:nth-child(n+5) {
        text-align: center;
        flex-basis: 25%
    }
}

@container (width>=650px) {
    .top-nav__username--highresolution {
        display: flex
    }
}

@container (width>=520px) and (width<=600px) {
    .top-nav__stats {
        display: grid
    }
    .top-nav__ratio-bar.top-nav__ratio-bar {
        display: none
    }
}

@container (width<=520px) {
    .top-nav__ratio-bar.top-nav__ratio-bar {
        display: none
    }
}

@media screen and (width<=767px) {
    .top-nav__main-menus {
        display: none
    }
    .top-nav__toggle {
        font-size: 2.5rem;
        position: absolute;
        top: 2.5rem;
        right: 2.5rem
    }
    .top-nav {
        padding-bottom: .5rem
    }
    main {
        margin: 0
    }
}

.top-nav__main-menus {
    gap: 3px
}

.top-nav__main-menus>li {
    background: var(--bg-2);
    border-radius: 6px;
    position: relative
}

.top-nav__dropdown>ul {
    top: 30px
}

.top-nav__icon-bar .top-nav__dropdown>ul {
    top: 32px;
    right: 0
}

.nav-tab-menu__items {
    top: 30px
}

.quick-search {
    max-width: 280px;
    height: 32px;
    top: 66px
}

.quick-search__inputs {
    width: 100%
}

body>header {
    position: unset
}

.top-nav--left__container .progress {
    width: 100%;
    height: 2px;
    position: absolute;
    bottom: 0
}

.secondary-nav {
    width: calc(100% - 4rem);
    margin-left: 2rem;
    position: relative
}

.panel__heading {
    padding: 7px 10px
}

.torrent-search__filters {
    margin: 0 1rem
}

.meta__backdrop {
    top: 0
}

#missing-media-table.data-table>tbody>tr>td {
    font-size: 11px
}

.top-nav__branding {
    width: 220px;
    height: 60px
}

.top-nav.mobile {
    flex-direction: column;
    display: flex
}

.top-nav__right.mobile {
    width: 100%;
    top: unset
}

.top-nav__main-menus.mobile {
    width: 100%;
    margin-bottom: 16px
}

.top-nav__main-menus.mobile>li {
    width: 100%
}

.chatbox-message__content {
    word-wrap: break-word
}

.footer {
    padding: 20px max(10px, 5vw - 30px, 10vw - 100px)
}
